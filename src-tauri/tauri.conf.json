{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vapourkit",
  "version": "2.1.0",
  "identifier": "com.vapourkit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "title": "Vapourkit (Tauri migration preview)",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../build/icon.ico"
    ]
  }
}
